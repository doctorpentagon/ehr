# Awibi EHR — Backend environment
#
# Copy to `.env` and fill in. Never commit the filled-in file.
# The server refuses to start in production if any secret below is missing or
# still holds a development default — that check is deliberate, do not remove it.

# ── Database ─────────────────────────────────────────────────────────────────
# Render, Supabase or any PostgreSQL. DIRECT_URL matters when the main URL goes
# through a connection pooler: Prisma migrations need the unpooled connection.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each one separately:  openssl rand -base64 48
# Reusing one value across all three means one leak compromises all three.
JWT_SECRET=
JWT_REFRESH_SECRET=
AWIBI_SHARED_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000

# The hospital's timezone. Every "today" figure — doses given, observations
# recorded, bookings — is counted against this. Managed hosts default to UTC,
# and Lagos is UTC+1, so leaving it unset puts the night shift's first hour on
# the previous day in every report.
TZ=Africa/Lagos

# Comma-separated origins allowed to call this API.
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-landing.vercel.app

# ── Identity service (optional) ──────────────────────────────────────────────
# The EHR runs without this. When unreachable it degrades gracefully and issues
# its own patient identifiers.
IDENTITY_API_URL=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Used for booking confirmations and receipts. Failures are logged and never
# block a clinical workflow.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Payments (optional) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── File storage (optional) ──────────────────────────────────────────────────
# Without these, uploads are stored on the server's local disk — which most
# hosts wipe on redeploy. Set these if uploaded documents must survive.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Demo access ──────────────────────────────────────────────────────────────
# Local development only. The server HARD-EXITS if this is `true` while
# NODE_ENV=production — that guard is deliberate, do not remove it.
# LOCAL_DEMO_ACCESS=true

# ── Hosted demo ──────────────────────────────────────────────────────────────
# Opens the passwordless role picker on a deployed instance so evaluators can
# try the system without accounts being created for them.
#
# ANYONE WHO REACHES THE URL CAN SIGN IN AS ANY ROLE IN ANY FACILITY, including
# Super Admin. Only ever point such an instance at invented data.
#
# Both variables are required — the second exists so this cannot be switched on
# by copying a config file without reading it.
# DEMO_MODE=true
# DEMO_MODE_ACKNOWLEDGED=i-understand-anyone-with-the-url-can-sign-in
#
# Strongly recommended alongside the above: a shared code evaluators enter once.
# Not real authentication, but it stops a forwarded link or a search result from
# being an open door.
# DEMO_ACCESS_CODE=
