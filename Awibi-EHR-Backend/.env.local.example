# Local development / test environment for the EHR backend.
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# `.env.local` is loaded by scripts/run-local.js, which also injects
# LOCAL_DEMO_ACCESS=true for the passwordless demo picker.
#
# NEVER commit a filled-in .env.local. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Database ---------------------------------------------------------------
# A local PostgreSQL. Both point at the same local DB; DIRECT_URL is used by
# `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/awibi_local"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/awibi_local"

# --- Auth secrets (generate your own; must differ from each other) ----------
JWT_SECRET="replace-with-48-random-bytes-hex"
JWT_REFRESH_SECRET="replace-with-a-different-48-random-bytes-hex"
AWIBI_SHARED_SECRET="replace-with-random-value-shared-with-identity-backend"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
PORT="8000"
TZ="Africa/Lagos"
CORS_ORIGIN="http://localhost:5177"
FRONTEND_URL="http://localhost:5177"
IDENTITY_API_URL="http://localhost:8001"

# --- Demo seed accounts (invented, local-only; required by `npm run seed`) ---
# The demo seed refuses to run without these. Use throwaway addresses; the
# password is what the seeded staff accounts share.
DEMO_PASSWORD="choose-a-local-demo-password"
DEMO_ADMIN_EMAIL="admin@example.local"
DEMO_DOCTOR_EMAIL="doctor@example.local"
DEMO_NURSE_EMAIL="nurse@example.local"
DEMO_RECORDS_EMAIL="records@example.local"
DEMO_LAB_EMAIL="lab@example.local"
DEMO_SUPERADMIN_EMAIL="superadmin@example.local"
DEMO_PHARMACIST_EMAIL="pharmacist@example.local"
