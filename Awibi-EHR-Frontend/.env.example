# Awibi EHR — Frontend environment
#
# Copy to `.env` and fill in. Never commit the filled-in file.
#
# IMPORTANT: Vite inlines every VITE_* value into the built JavaScript. Anything
# here is readable by anyone who opens the site. Put public configuration here
# and nothing else — never an API secret, never a database URL.

# Where the EHR API lives. No trailing slash.
VITE_API_URL=https://your-backend.onrender.com/v1

# Optional: shown on the public clinic pages.
VITE_APP_NAME=Awibi EHR
